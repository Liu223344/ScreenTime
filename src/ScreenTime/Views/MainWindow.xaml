<Window x:Class="ScreenTime.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="ScreenTime - 屏幕使用时间"
        Height="680" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        Loaded="MainWindow_OnLoaded"
        StateChanged="MainWindow_OnStateChanged">
    <Grid>
        <TabControl Margin="12" Background="White" Padding="8">

            <!-- ============== 今日 ============== -->
            <TabItem Header="今日">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <!-- 顶部统计卡片 -->
                        <UniformGrid Columns="4" Margin="0,8,0,12">
                            <Border Background="#E8F1FB" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="今日活跃" Foreground="#666" FontSize="12"/>
                                    <TextBlock Text="{Binding TodayActiveDisplay}" FontSize="26" FontWeight="Bold" Foreground="#1F6FEB"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF4E8" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="闲置时长" Foreground="#666" FontSize="12"/>
                                    <TextBlock Text="{Binding TodayIdleDisplay}" FontSize="26" FontWeight="Bold" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F1E8FB" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="锁屏时长" Foreground="#666" FontSize="12"/>
                                    <TextBlock Text="{Binding TodayLockedDisplay}" FontSize="26" FontWeight="Bold" Foreground="#7C3AED"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#E8FBF1" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="活跃占比" Foreground="#666" FontSize="12"/>
                                    <TextBlock Text="{Binding TodayActiveRatioDisplay}" FontSize="26" FontWeight="Bold" Foreground="#10A37F"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Button Content="🔄 刷新数据" Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Right" Margin="0,0,4,8" Padding="12,4"/>

                        <!-- 24 小时柱状图 -->
                        <Border Background="White" CornerRadius="8" Padding="8" Margin="4,4,4,8" MinHeight="240">
                            <oxy:PlotView Model="{Binding HourlyChart}" MinHeight="220"/>
                        </Border>

                        <!-- Top 5 应用条形图 -->
                        <Border Background="White" CornerRadius="8" Padding="8" Margin="4,4,4,8" MinHeight="220">
                            <oxy:PlotView Model="{Binding TopAppsChart}" MinHeight="200"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============== 历史 ============== -->
            <TabItem Header="历史">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="8" Padding="8" Margin="4,4,4,8" MinHeight="240" Grid.Row="0">
                        <oxy:PlotView Model="{Binding HistoryChart}" MinHeight="220"/>
                    </Border>

                    <Border Background="White" CornerRadius="8" Padding="4" Margin="4" Grid.Row="1">
                        <DataGrid ItemsSource="{Binding HistoryRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="100"/>
                                <DataGridTextColumn Header="活跃" Binding="{Binding ActiveSeconds, StringFormat=\{0\} s}" Width="100"/>
                                <DataGridTextColumn Header="闲置" Binding="{Binding IdleSeconds, StringFormat=\{0\} s}" Width="100"/>
                                <DataGridTextColumn Header="锁屏" Binding="{Binding LockedSeconds, StringFormat=\{0\} s}" Width="100"/>
                                <DataGridTextColumn Header="最常用应用" Binding="{Binding TopApp}" Width="*"/>
                                <DataGridTextColumn Header="最常用时长" Binding="{Binding TopAppSeconds, StringFormat=\{0\} s}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============== 设置 ============== -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="8,8,8,16" MaxWidth="560" HorizontalAlignment="Left">

                        <GroupBox Header="追踪" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="闲置阈值(无输入达到该秒数视为闲置)" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Minimum="30" Maximum="300" Width="320"
                                            Value="{Binding IdleThresholdSec}"
                                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding IdleThresholdSec}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Width="50"/>
                                    <TextBlock Text="秒" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="休息提醒" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="启用休息提醒"
                                          IsChecked="{Binding ReminderEnabled}" Margin="0,0,0,8"/>
                                <TextBlock Text="提醒间隔(分钟)" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="80" VerticalAlignment="Center">
                                        <TextBox.Text>
                                            <Binding Path="ReminderIntervalMin" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <ExceptionValidationRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox Content="今日暂停提醒"
                                          IsChecked="{Binding IsReminderMuted}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="数据" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="数据保留天数(超过则清理)" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="80" VerticalAlignment="Center">
                                        <TextBox.Text>
                                            <Binding Path="RetentionDays" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <ExceptionValidationRule/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Text="天" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Button Content="立即清理旧数据" Command="{Binding PurgeNowCommand}"
                                            Margin="24,0,0,0" Padding="12,4"/>
                                </StackPanel>
                                <Button Content="导出近 30 天数据为 CSV"
                                        Command="{Binding ExportCsvCommand}"
                                        Margin="0,12,0,0" Padding="12,4" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="系统" Padding="12" Margin="0,0,0,12">
                            <CheckBox Content="开机自启动"
                                      IsChecked="{Binding AutoStartWithWindows}"/>
                        </GroupBox>

                        <Button Content="保存设置" Command="{Binding SaveSettingsCommand}"
                                Padding="20,8" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
